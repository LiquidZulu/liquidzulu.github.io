---
import '../../css/global.css';
import {
    SkipToContent,
    Logo,
    Footer,
    LazyImage,
    MotionCanvasEmbed,
} from '../../components';
import { McasNavbar } from './components';

import { Prism } from '@astrojs/prism';

import imperativeAnimation from '../../../animation/dist/src/imperative-animation/imperative-animation?url';
import quoteExample from '../../../animation/dist/src/quote-example/quote-example?url';
import glowingTextPopin from '../../../animation/dist/src/glowing-text-popin/glowing-text-popin?url';
import Layout from '../../layouts/McasLayout.astro';
---

<Layout>
    <main class="text-slate-50 w-screen">
        <SkipToContent href="#1" />
        <McasNavbar />
        <div class="w-full h-[80svh] top-0 grid place-items-center">
            <div
                class="mx-6 flex flex-wrap w-full justify-center items-center gap-14">
                <div class="space-y-5 text-center">
                    <h1 class="text-slate-50 text-8xl font-black">MCAS</h1>
                    <h2 class="text-slate-300 text-2xl md:text-3xl font-medium">
                        Procedural animation, without the <span
                            class="mcas-emphasis">hassle</span
                        >.
                    </h2>
                    <div class="">
                        <div
                            class="mr-4 relative inline-flex group hover:scale-110 transition-all duration-500 hover:duration-200">
                            <div
                                class="absolute transition-all duration-500 opacity-30 -inset-px bg-gradient-to-r to-emerald-500 from-lime-400 rounded-xl blur-lg group-hover:opacity-100 group-hover:-inset-1 group-hover:duration-100 animate-tilt">
                            </div>
                            <a
                                href="/mcas/quickstart"
                                title="quickstart"
                                class="btn btn-neutral relative inline-flex items-center justify-center uppercase font-bold text-white transition-all duration-200 bg-slate-950 hover:bg-slate-900 font-pj focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
                                role="button"
                                style="text-decoration: none;"
                                >quickstart
                            </a>
                        </div>
                        <div class="join">
                            <a
                                class="btn-neutral join-item btn uppercase"
                                style="text-decoration: none;">lib docs</a
                            >
                            <a
                                class="btn-neutral join-item btn uppercase"
                                style="text-decoration: none;">
                                cli docs</a
                            >
                        </div>
                    </div>
                </div>
                <div class="rounded-md mockup-code bg-slate-950">
                    <pre data-prefix="$"><code>mcas -q script.org</code></pre>
                    <pre
                        data-prefix=">"
                        class="text-yellow-300"><code>generating animations...</code></pre>
                    <pre
                        data-prefix=">"
                        class="text-green-500"><code>Done!</code></pre>
                </div>
            </div>
        </div>
        <div class="w-full top-0 grid gap-32 place-items-center">
            <div class="mx-6 grid w-full justify-center gap-14">
                <div class="space-y-5 text-center">
                    <h2 class="text-slate-300 text-2xl md:text-3xl font-medium">
                        Beautiful animations, <br />
                        <span class="mcas-emphasis">minimal code</span>.
                    </h2>
                </div>
                <div
                    class="flex flex-row flex-wrap justify-center place-items-center place-content-center items-center justify-items-center content-center align-items-center place-items-center gap-12 max-w-[100vw]">
                    {/* prettier-ignore */}
                    <Prism
                        code={// prettier-ignore
                        `import aristotle from './assets/aristotle.png';\nimport quotes from './assets/aristotle.org-quotes';\nimport { makeQuoteScene } from 'mcas/scenes/quote';\n\nconst cardMap = new Map([['aristotle', aristotle]]);\n\nexport const quoteScenes = quotes.map((x, i) =>\n  makeQuoteScene(\n    cardMap.get(x.author),\n    x,\n    x.citation,\n    \`quote-\${i}\`,\n    { bg: true, }\n  )\n);`}
                        lang="ts"
                    />
                    <MotionCanvasEmbed
                        url={quoteExample}
                        mode="large"
                        classes={'flex flex-content w-[50vw] place-self-center self-center justify-self-center justify-center place-items-center place-content-center items-center justify-items-center content-center align-items-center place-items-center '.split(
                            ' '
                        )}
                    />
                </div>
            </div>
            <div
                class="mx-6 p-6 flex flex-row-reverse flex-wrap w-full justify-center items-center gap-14">
                <div class="space-y-5 text-center">
                    <h2 class="text-slate-300 text-2xl md:text-3xl font-medium">
                        <span class="mcas-emphasis">Integrates</span> with your editing
                        workflow.
                    </h2>
                    <h3 class="text-xl">
                        Export animations as image sequences <br /> or .mp4 files
                        for use in any non-linear editor.
                    </h3>
                </div>
                <div
                    class="h-32 flex flex-row justify-center items-center gap-8">
                    <img
                        class="h-full"
                        src="/images/mcas/premier.png"
                        loading="lazy"
                    />
                    <img
                        class="h-full"
                        src="/images/mcas/resolve.png"
                        loading="lazy"
                    />
                    <img
                        class="h-full"
                        src="/images/mcas/kdenlive.png"
                        loading="lazy"
                    />
                </div>
            </div>
            <div
                class="mx-6 p-6 flex flex-row flex-wrap w-full justify-center items-center gap-14">
                <div class="space-y-5 text-center">
                    <h2 class="text-slate-300 text-2xl md:text-3xl font-medium">
                        Completely free,<br /> better than <span
                            class="mcas-emphasis">After Effects</span
                        >.
                    </h2>
                    <h3 class="text-xl">
                        MCAS is built on top of <a
                            href="https://motioncanvas.io">motion canvas</a
                        >,<br /> meaning you can write your animations<br /> in whatever
                        text editor you desire,<br /> and have it all rendered in
                        the browser.
                    </h3>
                </div>
                <div
                    class="h-32 flex flex-row justify-center items-center gap-8">
                    <ul class="text-lg">
                        <li>
                            <span class="mcas-emphasis">Generate</span> animations
                            from your video script.
                        </li>
                        <li>
                            <span class="mcas-emphasis">Reuse</span> animations with
                            ease.
                        </li>
                        <li>
                            Write animations <span class="mcas-emphasis"
                                >imperatively</span
                            >—no more keyframes.
                        </li>
                    </ul>
                </div>
            </div>
            <div class="mx-6 p-6 grid w-full place-items-center gap-14">
                <div class="grid gap-8 place-items-center">
                    <h2 class="text-slate-300 text-2xl md:text-3xl font-medium">
                        <span class="mcas-emphasis">Imperative</span> first.
                    </h2>

                    <h3 class="text-xl text-center">
                        With standard keyframe animation, updating one keyframe<br
                        />
                        does not automatically update every keyframe after that.
                        <br /><a href="https://motioncanvas.io">Motion canvas</a
                        > deals with <i>duration</i>, not frames.
                    </h3>
                </div>
                <MotionCanvasEmbed
                    url={imperativeAnimation}
                    mode="large"
                    classes={'w-[50vw]'.split(' ')}
                />
            </div>
            <div
                class="mx-6 p-6 flex flex-row flex-wrap w-full justify-center items-center gap-14">
                <div class="grid gap-14">
                    <div class="space-y-5 text-center">
                        <h2
                            class="text-slate-300 text-2xl md:text-3xl font-medium">
                            <span
                                class="gradient-text font-black bg-gradient-to-r from-lime-500 to-emerald-500"
                                >Extended</span
                            > asset library.
                        </h2>
                        <h3 class="text-xl">
                            MCAS comes with extended <a
                                href="https://motioncanvas.io">motion canvas</a
                            >
                            <br /> components and utilities.
                        </h3>
                    </div>
                    <MotionCanvasEmbed
                        url={glowingTextPopin}
                        mode="large"
                        classes={'flex flex-content w-[50vw] place-self-center self-center justify-self-center justify-center place-items-center place-content-center items-center justify-items-center content-center align-items-center place-items-center '.split(
                            ' '
                        )}
                    />
                </div>
                <div
                    class="w-full md:w-[60vw] lg:w-[40vw] flex flex-wrap flex-row justify-center items-center gap-8">
                    {/* prettier-ignore */}
                    <Prism
                        code={`// ...

import {
  colors,
  McasTxt as Txt,
  popin,
  popout
} from 'mcas';

export default makeScene2D(function* (view) {
  view.fill(colors.bg);

  const glowingText = createRef<Txt>();
  view.add(
    <Txt
      glow // <-- MCAS specific
      fontFamily="Oswald"
      fill="red"
      ref={glowingText}>
      HELLO WORLD
    </Txt>,
  );

  yield* popin(glowingText);
  yield* waitFor(5);
  yield* popout(glowingText);
});`}
                        lang="tsx"
                    />
                </div>
            </div>
            <div
                class="mx-6 p-6 grid w-full justify-center items-center gap-14">
                <div class="space-y-5 text-center">
                    <h2 class="text-slate-300 text-2xl md:text-3xl font-medium">
                        Motion Canvas is <span class="mcas-emphasis"
                            >battle tested</span
                        >.
                    </h2>
                </div>
                <iframe
                    width="640"
                    height="360"
                    src="https://www.youtube.com/embed/WTUafAwrunE"
                    title="Animating with Code - Motion Canvas"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen></iframe>
            </div>
        </div>
    </main>
    <Footer noShadow={true} bg />
</Layout>

<style>
    ul li:before {
        content: '⮕';
        margin-right: 0.4em;
    }
    a {
        @apply hover:underline text-emerald-500;
    }
</style>
