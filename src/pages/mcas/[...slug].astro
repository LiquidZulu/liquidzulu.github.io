---
import '../../css/global.css';
import { Debug } from 'astro/components';
import { ViewTransitions } from 'astro:transitions';
import { getCollection, getEntryBySlug } from 'astro:content';
import { McasNavbar } from './components';
import { deepCollection } from '../../util/collections.tsx';

const mcas = await getCollection('mcas');

export const getStaticPaths = async () => {
    const mcas = await getCollection('mcas');
    return mcas.map(i => ({ params: { slug: i.slug } }));
};

const { slug } = Astro.params;
const info = await getEntryBySlug('mcas', slug);

const { Content, headings } = await info.render();

const blah = {
    lib: {},
    files: [],
};

import Layout from '../../layouts/McasLayout.astro';
import {
    SkipToContent,
    Footer,
    TOC,
    DeepCollectionDropdown,
} from '../../components';
---

<Layout>
    <ViewTransitions slot="head" />
    <SkipToContent href="#md-content" />
    <McasNavbar />
    <main id="md-content" class="w-full flex flex-row">
        <div class="bg-zinc-950">
            <TOC slug={slug} headings={headings}>
                <li class="cubano mb-2 border-b-2 border-zinc-700 text-lg">
                    documentation
                </li>
                <li client:load transition:persist>
                    <DeepCollectionDropdown collection={deepCollection(mcas)} />
                </li>
            </TOC>
        </div>
        <article
            class="max-w-[64rem] m-auto min-h-[80vh] mt-6 text-justify md:p-16 p-6">
            <Content />
        </article>
    </main>
    <Footer />
</Layout>
<!-- is:global required to apply styles to the rendered MD -->
<style is:global lang="scss">
    table {
        @apply border-separate border-spacing-x-8;
    }
    th,
    td {
        @apply py-2;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: Oswald;
    }

    .text-1xl {
        @apply text-xl;
    }

    @for $i from 2 through 6 {
        h#{$i} {
            @apply text-#{7 - $i}xl;
        }
    }

    .link-exists {
        @apply text-[#7C3AED] hover:text-[#9e67fc];
    }

    .link-doesnt-exist {
        @apply text-[#7C3AED]/50 cursor-not-allowed;
    }

    .footnotes {
        a {
            color: #7c3aed !important;
        }
    }

    .fn-highlight {
        @apply bg-zinc-600 rounded-sm p-[0.5rem] m-[-0.5rem];
    }
    #md-content {
        :not(pre) > code {
            @apply bg-slate-950 rounded-md p-2 border border-zinc-700;
        }

        article {
            pre {
                @apply m-12 p-6 rounded-lg;
            }

            a {
                @apply text-emerald-400 hover:underline;
            }

            sup {
                a {
                    &::after {
                        content: '' !important;
                    }
                    color: #71717a !important;
                }
            }
        }

        .section-heading-link {
            -webkit-mask: url('/link.svg') no-repeat 50% 50%;
            mask: url('/link.svg') no-repeat 50% 50%;
            -webkit-mask-size: cover;
            mask-size: cover;
            @apply shrink-0 w-[2.5rem] h-[2rem] overflow-visible bg-slate-50 opacity-[0] ml-[-2.5rem] mr-2 transition-all;

            &:focus {
                @apply opacity-[0.8] bg-sky-500 scale-110;
            }
        }
        .header-wrapper {
            @apply flex items-center justify-center;

            &:hover {
                .section-heading-link {
                    @apply opacity-[0.2];
                }
            }
        }
        /*
            // abandoned because I cant turn a ::before into a link
            h1::before,
            h2::before,
            h3::before,
            h4::before {
            content: '';
            -webkit-mask: url('/link.svg') no-repeat 50% 50%;
            mask: url('/link.svg') no-repeat 50% 50%;
            -webkit-mask-size: cover;
            mask-size: cover;
            display: inline-block;
            width: 2rem;
            height: 2rem;
            @apply bg-slate-50 opacity-[0.2];
            }*/
        h1 {
            @apply text-6xl font-bold text-center mt-24 mb-16;
        }

        h2 {
            @apply text-5xl font-bold text-center mt-20 mb-12;
        }

        h3 {
            @apply text-5xl font-semibold text-center mt-16 mb-10;
        }

        h4 {
            @apply text-4xl font-semibold text-center mt-8 mb-4;
        }

        p,
        ol {
            @apply my-4 text-justify text-lg min-[2000px]:text-2xl min-[2500px]:text-3xl;
        }

        blockquote {
            @apply border-l-4 border-emerald-400 pl-4;
        }

        img {
            margin: auto;
        }

        article {
            ol,
            ul {
                @apply ml-6;
            }

            ol {
                @apply list-decimal;
            }

            ul {
                @apply list-disc;
            }

            /* a {
                @apply text-sky-500;

                &:not(.footref) {
                @apply hover:link;
                }
                } */

            .footnotes {
                & ~ p {
                    @apply text-left;
                }

                & li::marker {
                    @apply text-zinc-500;
                }
            }
        }
    }
</style>
