<script>
    const scrollCoffee = document.getElementById('scrollCoffee');

    if (!!scrollCoffee) {
        function scrollSpy() {
            if (window.scrollY > 4000) {
                scrollCoffee.classList.add('show');
                scrollCoffee.classList.remove('hide');
            } else {
                scrollCoffee.classList.add('hide');
                scrollCoffee.classList.remove('show');
            }
        }

        window.addEventListener('scroll', scrollSpy);
        scrollSpy();
    }

    const logo = document.getElementById('logo-img');

    scrollCoffee.addEventListener('mouseover', () => {
        logo.animate(
            [
                { transform: 'rotate(0) scale(1)' },
                { transform: 'rotate(-20deg) scale(1.2)' },
                { transform: 'rotate(20deg) scale(1.2)' },
                { transform: 'rotate(0) scale(1)' },
            ],
            { duration: 300, iterations: 1 }
        );
    });
</script>

<a
    id="scrollCoffee"
    class="hide duration-300 transition-all ease-in-out fixed bottom-5 right-[4.2rem] hover:right-[5rem]"
    href="https://ko-fi.com/liquidzulu/tiers"
    target="_blank">
    <button
        class="h-10 flex content-center bg-slate-900 rounded-full py-0 px-2 border-none hover:scale-110 ring-amber-500 hover:ring-4 transition-all ease-in-out duration-300">
        <img id="logo-img" class="h-full shrink" src="/kofi.png" />
        <p class="cubano h-full grid place-items-center mr-1">
            <slot />
        </p>
    </button>
</a>

<style>
    .hide {
        @apply opacity-0 translate-y-8 hidden kofi-logo:block scale-75;
    }
    .show {
        @apply opacity-0 translate-y-8 scale-75 kofi-logo:opacity-100 kofi-logo:translate-y-0 kofi-logo:scale-100;
    }
</style>
