---
import { Icon } from 'astro-icon/components';
const { slug, url, alt, className } = Astro.props;
---

<a href={url} aria-label={!!alt ? alt : ''} title={!!alt ? alt : ''}>
    <Icon
        name={slug}
        class={`text-zinc-500 transition-all ease-in-out hover:scale-110 w-8 h-8 icon-${slug} ${className}`}
    />
</a>

<script>
    // this USED to work with just CSS and then SOMEBODY decided it would be a good idea to deprecate the function that I used for my fucking svg loader and now I am stuck using this piece of garbage that apparently works by fucking magic and if you don't say the magic words right then standard fucking css breaks down and takes a nap when you are trying to fucking colour the god damn logo
    for (let astro of document.getElementsByClassName('icon-astro')) {
        astro.addEventListener('mouseover', () => {
            astro.getElementsByClassName('astro-a')[0].style.fill = '#fff';
            astro.getElementsByClassName('astro-flame')[0].style.fill =
                '#ff5d01';
        });
        astro.addEventListener('mouseout', () => {
            astro.getElementsByClassName('astro-a')[0].style.fill = '#71717A';
            astro.getElementsByClassName('astro-flame')[0].style.fill =
                '#71717A';
        });
    }
</script>

